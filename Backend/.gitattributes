# 1. 기본 설정 (자동 인식)
* text=auto

# 2. 실행 스크립트 (운영체제별 고정 - 매우 중요!)
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# 3. 소스 코드 (Jetson과 협업을 위해 LF로 통일 권장)
*.java text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# 4. 바이너리 파일
*.jpg binary
*.png binary
*.gif binary